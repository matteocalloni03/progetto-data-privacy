# Privacy Gateway Security & Environment Configuration
# Copy this file to .env and configure secrets accordingly

# Cryptographic Pseudonymization Salt / Key (HMAC-SHA256)
PSEUDONYMIZATION_SECRET_KEY=dev-secret-salt-replace-in-production-2026-gdpr

# Privacy Gateway Security Settings
GATEWAY_MAX_QUERIES_PER_MINUTE=10
GATEWAY_SMALL_CELL_THRESHOLD=5
GATEWAY_DEFAULT_EPSILON_BUDGET=5.0
GATEWAY_DEFAULT_K_ANONYMITY=5

# Audit Logging & File Storage
DATA_DIR=data
AUDIT_LOG_FILE=data/logs/audit_log.jsonl
INCIDENT_REPORTS_DIR=data/incidents

# Web Dashboard Server
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
